# SmartTravel AI Environment Configuration

# Google Maps Platform / Google Places API (New)
# Required for live place search, details, photos, and ratings
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# OpenWeather API Key
# Required for live current weather and 5-day forecasts (Fallback: Open-Meteo)
OPENWEATHER_API_KEY="your_openweather_api_key_here"

# Gemini LLM Configuration
# Model to use: defaults to gemini-3.8-flash (e.g. gemini-3.8-flash, gemini-2.5-flash)
GEMINI_MODEL="gemini-3.8-flash"

# Google Gemini API Key
# Required for AI Travel Assistant chatbot & Itinerary Polishing (Fallback: Local structured database interpreter)
GEMINI_API_KEY="your_gemini_api_key_here"
LLM_API_KEY="your_gemini_api_key_here"
