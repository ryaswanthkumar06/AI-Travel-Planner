# SmartTravel AI Environment Configuration

# Google Maps Platform / Google Places API (New)
# Required for live place search, details, photos, and ratings
GOOGLE_MAPS_API_KEY=your_key_here

# OpenWeather API Key
# Required for live current weather and 5-day forecasts (Fallback: Open-Meteo)
OPENWEATHER_API_KEY=your_key_here

# LLM API Key (e.g., Google Gemini / LLM Provider)
# Required for AI Travel Assistant chatbot (Fallback: Local structured database interpreter)
GEMINI_API_KEY=your_key_here
LLM_API_KEY=your_key_here
